# ──────────────────────────────────────────────────────────
# NexusQuery — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true

# Anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Azure Databricks
# Server hostname: <your-databricks-server-hostname>
DATABRICKS_SERVER_HOSTNAME=replace-me

# HTTP path: from cluster → Advanced → JDBC/ODBC tab
# Example: /sql/1.0/warehouses/xxxx  or  /sql/protocolv1/o/xxx/xxx
DATABRICKS_HTTP_PATH=

# Personal access token: Databricks UI → top right → Settings → Developer → Access tokens
DATABRICKS_ACCESS_TOKEN=

# ADLS Gen2 (informational)
ADLS_GOLD_BASE=abfss://gold@<your-storage-account-name>.dfs.core.windows.net

# Chat settings
MAX_HISTORY_TURNS=20
SQL_ROW_LIMIT=500
AZURE_STORAGE_ACCOUNT_NAME=replace-me
AZURE_STORAGE_ACCOUNT_KEY=replace-me
ADLS_GOLD_BASE=abfss://gold@<your-storage-account-name>.dfs.core.windows.net